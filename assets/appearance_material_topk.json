{
  "field_name": "appearance_material_topk",
  "type": "topk_enum_with_score",
  "required": true,
  "description": "基于视觉证据与常识推断的交互相关材质原型 top-k。不是成分分解，也不是真实质量占比。",
  "annotation_rule": "选择 1 到 3 个最能描述该实例整体交互印象的材质原型。score 表示匹配度/确信度，不强制解释为真实概率。",
  "constraints": {
    "min_items": 1,
    "max_items": 3,
    "score_range": [
      0.0,
      1.0
    ]
  },
  "prototype_definitions": [
    {
      "name": "wood_like",
      "definition": "视觉上像木材/木板，通常偏硬、质量中等到较高。",
      "typical_examples": [
        "wood chair",
        "wood table",
        "wood shelf"
      ]
    },
    {
      "name": "metal_like",
      "definition": "视觉上像金属，通常偏硬、偏重。",
      "typical_examples": [
        "metal frame",
        "steel cabinet",
        "aluminum lamp"
      ]
    },
    {
      "name": "brittle_mineral_like",
      "definition": "视觉上像玻璃/陶瓷/石材/砖等脆性矿物类。",
      "typical_examples": [
        "glass vase",
        "ceramic mug",
        "marble countertop",
        "brick wall"
      ]
    },
    {
      "name": "rigid_plastic_like",
